# ---------------------------------------------------------------- servidor --
PORT=8080

# development | production
APP_ENV=development

# debug | info | warn | error
LOG_LEVEL=info

# Segundos de espera pelas requisições em voo no desligamento
SHUTDOWN_TIMEOUT_SECONDS=10

# ------------------------------------------------------------- banco de dados
# Deve bater com o docker-compose.yml deste diretório (host: porta 5434).
DATABASE_URL=postgres://financas:financas@localhost:5434/financas?sslmode=disable

# ---------------------------------------------------------------------- auth --
# Obrigatório. Gere o seu com: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=financas-api
JWT_EXPIRATION_HOURS=24

# Custo do bcrypt. 0 usa o padrão da biblioteca (10).
BCRYPT_COST=0

# ---------------------------------------------------------------------- cors --
# Origens liberadas, separadas por vírgula
ALLOWED_ORIGINS=http://localhost:5173
